# Copy to .env.local and fill in from the Firebase console:
#   Project settings -> General -> Your apps -> Web app -> SDK setup and configuration
#
# These VITE_* values are inlined into the browser bundle and are PUBLIC by
# design. The API key identifies the project, it does not grant access -
# firestore.rules is what actually protects the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=bycarolinecls-2144b.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bycarolinecls-2144b
VITE_FIREBASE_STORAGE_BUCKET=bycarolinecls-2144b.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Server-side only (Cloudflare Pages env vars, NOT prefixed VITE_) ---
# Used by /api/availability and /api/pricing to read the two public documents
# via the Firestore REST API. Same project id as above.
FIREBASE_PROJECT_ID=bycarolinecls-2144b

# Timezone bookings are bucketed by.
BUSINESS_TIMEZONE=Asia/Jakarta

# Set to 'coming-soon' to serve a holding page on the PUBLIC site while you
# finish the content. /admin is a separate build and is unaffected - it stays
# fully usable. Remove this or set 'live' to launch.
VITE_SITE_MODE=live

# --- Invoice payment details ---
# Kept out of the repo because it is public. Set these in Cloudflare Pages
# environment variables (and in .env.local for local development).
VITE_BANK_NAME=
VITE_BANK_ACCOUNT_NAME=
VITE_BANK_ACCOUNT_NO=
